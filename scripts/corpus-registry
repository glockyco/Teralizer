#!/usr/bin/env bash
set -euo pipefail

CORPUS_REGISTRY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

corpus_registry_query() {
  if [[ -n "${TERALIZER_COMPOSE_FILE:-}" ]]; then
    docker compose -f "$TERALIZER_COMPOSE_FILE" run --rm -T analysis -m teralizer.corpora "$@"
  else
    uv run --directory "$CORPUS_REGISTRY_ROOT/analysis" python -m teralizer.corpora "$@"
  fi
}

corpus_registry_get() {
  corpus_registry_query get "$1" "$2"
}

corpus_registry_export() {
  local assignments
  assignments="$(corpus_registry_query export "$1")" || return
  eval "$assignments"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  corpus_registry_query "$@"
fi
