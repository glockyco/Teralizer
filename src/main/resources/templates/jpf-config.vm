## @vtlvariable name="symbolicMethod" type="java.lang.String"
## @vtlvariable name="classpath" type="java.lang.String"
## @vtlvariable name="jpfSymbcModelClasspath" type="java.lang.String"
## @vtlvariable name="maxExecutionTime" type="java.lang.Double"
## @vtlvariable name="maxPathConditionSize" type="java.lang.Long"
## @vtlvariable name="maxSearchDepth" type="java.lang.Integer"
## @vtlvariable name="driverClassQualifiedName" type="java.lang.String"
## @vtlvariable name="testClassQualifiedName" type="java.lang.String"
## @vtlvariable name="testMethodQualifiedName" type="java.lang.String"
## @vtlvariable name="testedClassQualifiedName" type="java.lang.String"
## @vtlvariable name="testedMethodQualifiedName" type="java.lang.String"
## @vtlvariable name="instrumentedClassQualifiedName" type="java.lang.String"
## @vtlvariable name="instrumentedMethodQualifiedName" type="java.lang.String"
## @vtlvariable name="instrumentedParameterNames" type="java.lang.String"
## @vtlvariable name="inputValuesPath" type="java.lang.String"
## @vtlvariable name="outputValuePath" type="java.lang.String"
## @vtlvariable name="inputSpecificationPath" type="java.lang.String"
## @vtlvariable name="outputSpecificationPath" type="java.lang.String"
## @vtlvariable name="reportPath" type="java.lang.String"
target=${driverClassQualifiedName}
#symbolic.class=...
symbolic.method=${symbolicMethod}
#symbolic.fields=...
classpath=${jpfSymbcModelClasspath}${pathSeparator}${classpath}
symbolic.collect_constraints=true
#symbolic.min_int=-100
#symbolic.max_int=100
#symbolic.min_long=-100
#symbolic.max_long=100
#symbolic.min_double=-100.0
#symbolic.max_double=100.0
symbolic.debug = false
symbolic.optimizechoices = false
# symbolic.arrays is rejected outright: SymbolicInstructionFactory throws a JPFConfigException
# when it is on together with symbolic.collect_constraints, which this analysis requires.
# symbolic.lazy was measured to change nothing here, because there is no aliasing choice to make
# along a single concrete path. Neither recovers a value read from the heap.
symbolic.strings=${symbolicStrings}
symbolic.dp=${symbolicDp}
symbolic.fp=${symbolicFp}
symbolic.bvlength=${symbolicBvLength}
# No symbolic.string_dp is set. SPF reads that as `none`, which selects no string solver, and
# measurement showed selecting one changes no result: a solver decides satisfiability, and this
# analysis only collects constraints. The timeout below is inert for the same reason.
symbolic.string_dp_timeout_ms=3000
test_generalization.max_execution_time=${maxExecutionTime}
test_generalization.max_path_condition_size=${maxPathConditionSize}
test_generalization.test_class=${testClassQualifiedName}
test_generalization.test_method=${testMethodQualifiedName}
test_generalization.tested_class=${testedClassQualifiedName}
test_generalization.tested_method=${testedMethodQualifiedName}
test_generalization.instrumented_class=${instrumentedClassQualifiedName}
test_generalization.instrumented_method=${instrumentedMethodQualifiedName}
test_generalization.instrumented_parameters=${instrumentedParameterNames}
test_generalization.input_values_path=${inputValuesPath}
test_generalization.output_value_path=${outputValuePath}
test_generalization.input_specification_path=${inputSpecificationPath}
test_generalization.output_specification_path=${outputSpecificationPath}
search.depth_limit=${maxSearchDepth}
search.multiple_errors=true
report.class=gov.nasa.jpf.report.Reporter
report.publisher=console
report.console.class=gov.nasa.jpf.report.ConsolePublisher
report.console.property_violation=error,trace,snapshot
report.console.file=${reportPath}
