# This is an example .env file. Copy this to .env and modify as needed.

# Database configuration
# The analysis scripts use two databases accessed via the same PostgreSQL instance.
# Database names are configurable for flexibility during reproduction testing.
DB_HOST=localhost
DB_PORT=5432
DB_USER=teralizer
DB_PASSWORD=teralizer

# Database names (configurable for reproduction testing)
# - DB_NAME_DEV: EqBench and Apache Commons Utils results (default: postgres_dev)
# - DB_NAME_TEST: RepoReapers extended dataset results (default: postgres_test)
DB_NAME_DEV=postgres_dev
DB_NAME_TEST=postgres_test

# Dataset variant for replication workflow
# Controls database selection and output directory:
# - original: Use original DBs, output to analysis/output/original/ (read-only reference)
# - verify: Use original DBs, output to analysis/output/verify/ (evaluator re-runs)
# - replicate: Use *_replication DBs, output to analysis/output/replicate/ (full reproduction)
DATASET_VARIANT=original

# Data directory for pipeline output (default: data)
# Use a separate directory for reproduction to avoid polluting original data
DATA_DIR=data

# GitHub token for dataset script
# Create at: GitHub Settings > Developer settings > Personal access tokens > Fine-grained tokens
# Required permissions: Contents (read) for public repositories
GITHUB_TOKEN=your_github_token_here

# Paper repository path for sync operations
# Path to the test-generalization-paper repository for syncing analysis outputs
PAPER_REPO_PATH=/path/to/test-generalization-paper

# Projects directory path for dataset analysis
# Path to the projects directory containing all evaluation projects (used by dataset-analysis.ipynb)
PROJECTS_PATH=/path/to/test-generalization-dev/projects
