# This is an example .env file. Copy this to .env and modify as needed.

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# GitHub token for dataset script
# Create at: GitHub Settings > Developer settings > Personal access tokens > Fine-grained tokens
# Required permissions: Contents (read) for public repositories
GITHUB_TOKEN=your_github_token_here

# Paper repository path for sync operations
# Path to the test-generalization-paper repository for syncing analysis outputs
PAPER_REPO_PATH=/path/to/test-generalization-paper

# Projects directory path for dataset analysis
# Path to the projects directory containing all evaluation projects (used by dataset-analysis.ipynb)
PROJECTS_PATH=/path/to/test-generalization-dev/projects
