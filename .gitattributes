# Large binary files stored with Git LFS
/src/main/resources/evosuite/evosuite-1.2.0.jar filter=lfs diff=lfs merge=lfs -text
/replication/datasets/*.dump filter=lfs diff=lfs merge=lfs -text
/analysis/output/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Shell scripts must have LF line endings
*.sh text eol=lf
gradlew text eol=lf
verification/golden/*.tsv text eol=lf
analysis/data/jarvis-cut-values/*.tsv text eol=lf
