# Dockerfile for the Python analysis and verification environment.
#
# The replication compose file uses this image for the one-shot `verify`
# service. Reviewer-facing report generation runs through uv on the host with
# replication/scripts/run-analysis.sh, so this image no longer serves a web UI.
# Build context should be the repository root:
#   docker build -f replication/Dockerfile.analysis -t teralizer-analysis .

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including fonts for matplotlib.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    fontconfig \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f -v

# Install uv for fast dependency management.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy the analysis package and install its locked runtime dependencies.
COPY analysis/pyproject.toml analysis/uv.lock* /app/analysis/
COPY analysis/src /app/analysis/src/

WORKDIR /app/analysis
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --frozen --no-dev 2>/dev/null || uv sync --no-dev

# Keep a writable output location for one-shot verification commands.
RUN mkdir -p /app/analysis/output

WORKDIR /app/analysis
