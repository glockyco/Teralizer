# Dockerfile for Teralizer analysis environment (Jupyter Lab).
#
# This container provides a pre-configured Python environment for running
# the analysis notebooks that reproduce paper figures and tables.
#
# Build context should be the repository root:
#   docker build -f replication/Dockerfile.analysis -t teralizer-analysis .

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy analysis package
COPY analysis/pyproject.toml analysis/uv.lock* /app/analysis/
COPY analysis/src /app/analysis/src/

# Install dependencies
WORKDIR /app/analysis
RUN uv sync --frozen --no-dev 2>/dev/null || uv sync --no-dev

# Install JupyterLab
RUN uv pip install jupyterlab

# Create output directory
RUN mkdir -p /app/analysis/output

WORKDIR /app/analysis

# Expose Jupyter port
EXPOSE 8888

# Start Jupyter Lab without authentication (for ease of reproduction)
# Security: Port is bound to localhost only in docker-compose.yml
CMD ["uv", "run", "jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=''", "--NotebookApp.password=''"]
