# Replication Package Environment Configuration
# Copy this file to .env and modify as needed.

# Database credentials
DB_USER=teralizer
DB_PASSWORD=teralizer

# Database names (leave as defaults unless you have conflicts)
DB_NAME_DEV=postgres_dev
DB_NAME_TEST=postgres_test

# Dataset variant (controls BOTH database selection AND output directory)
#
# | Variant   | Databases Used                    | Output Directory    |
# |-----------|-----------------------------------|---------------------|
# | verify    | postgres_dev, postgres_test       | output/verify/      |
# | replicate | postgres_*_replication databases  | output/replicate/   |
#
# The pre-computed outputs in output/original/ are read-only reference files.
# Evaluators generate verify/ or replicate/ outputs, then compare against original/.
#
# - verify: Re-run analysis on original data (default for evaluators)
# - replicate: Run analysis on replication data (after running pipeline)
DATASET_VARIANT=verify

# Port mappings (change if defaults conflict with existing services)
DB_PORT=5432
ADMINER_PORT=18080
JUPYTER_PORT=8888
