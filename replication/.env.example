# Replication Package Environment Configuration
# Copy this file to .env and modify as needed.

# Database credentials
DB_USER=teralizer
DB_PASSWORD=teralizer
# prepare-corpus creates this role and grants read-only corpus access.
REPORT_DB_USER=teralizer_report
REPORT_DB_PASSWORD=teralizer-report

# Select registered inputs with --corpus. The corpus registry owns database names.
# Pipeline reruns use a reserved scratch database by default.
# REPLICATION_SCRATCH_DB=scratch_replication_controlled

# Port mappings (change if defaults conflict with existing services)
DB_PORT=5432
ADMINER_PORT=18080
