# Replication Package Environment Configuration
# Copy this file to .env and modify as needed.

# Database credentials
REPLICATION_DB_USER=teralizer
REPLICATION_DB_PASSWORD=teralizer
# prepare-corpus creates this role and grants read-only corpus access.
REPLICATION_REPORT_DB_USER=teralizer_report
REPLICATION_REPORT_DB_PASSWORD=teralizer-report

# Select registered inputs with --corpus. The corpus registry owns database names.
# Pipeline reruns use a reserved scratch database by default.
# REPLICATION_SCRATCH_DB=scratch_replication_controlled

# Adminer's host port (change it if the default collides with another service)
REPLICATION_ADMINER_PORT=18080
