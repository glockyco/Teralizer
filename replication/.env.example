# Replication Package Environment Configuration
# Copy this file to .env and modify as needed.

# Database credentials
DB_USER=teralizer
DB_PASSWORD=teralizer

# Database names (leave as defaults unless you have conflicts)
DB_NAME_DEV=postgres_dev
DB_NAME_TEST=postgres_test

# Port mappings (change if defaults conflict with existing services)
DB_PORT=5432
ADMINER_PORT=18080
JUPYTER_PORT=8888
