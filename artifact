#!/usr/bin/env bash
# Reviewer commands for the Teralizer replication package.
#
# Usage:
#   ./artifact preflight [WORKFLOW]      Check the host and the extracted components
#   ./artifact smoke                     Restore the two JARVIS corpora and check RQ0
#   ./artifact reproduce-results [rq0]   Rebuild the reports and compare them with
#                                        the reference, all of them or RQ0 only
#   ./artifact collect-reduced CORPUS    Run the reduced test generalization scope
#   ./artifact collect-full CORPUS       Run every configuration of the corpus
#   ./artifact clean                     Remove the services, their volumes, and
#                                        the output and state directories
#
# CORPUS is controlled, real-world, jarvis-scenarios, or jarvis-benchmark.
#
# Run it from the extracted release. The release manifest is read from
# ../release-manifest.json, next to the downloaded archives, unless
# TERALIZER_RELEASE_MANIFEST names another file. COMPOSE_PROJECT_NAME (default
# teralizer) separates this workspace's services and volumes from others.
# TERALIZER_OUTPUT and TERALIZER_STATE move the output and state directories.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
RELEASE_MANIFEST="${TERALIZER_RELEASE_MANIFEST:-$ROOT/../release-manifest.json}"
export TERALIZER_OUTPUT="${TERALIZER_OUTPUT:-$ROOT/output}"
export TERALIZER_STATE="${TERALIZER_STATE:-$ROOT/state}"
# Bind sources are passed as absolute paths because Compose is in replication/.
[[ "$TERALIZER_OUTPUT" == /* || "$TERALIZER_OUTPUT" == ?:/* ]] || TERALIZER_OUTPUT="$PWD/$TERALIZER_OUTPUT"
[[ "$TERALIZER_STATE" == /* || "$TERALIZER_STATE" == ?:/* ]] || TERALIZER_STATE="$PWD/$TERALIZER_STATE"
export TERALIZER_UID="${TERALIZER_UID:-$(id -u)}"
export TERALIZER_GID="${TERALIZER_GID:-$(id -g)}"
COMPOSE_FILE="$ROOT/replication/docker-compose.yml"
COMPOSE=(docker compose -f "$COMPOSE_FILE")
REFERENCE=analysis/output/original/reference-manifest.json
JARVIS_CORPORA=(jarvis-scenarios jarvis-benchmark)
ALL_CORPORA=(controlled real-world jarvis-scenarios jarvis-benchmark)

usage() {
    sed -n '2,20p' "$0" | sed -E 's/^# ?//'
}

step() {
    printf '\n== %s\n' "$*"
}

fail() {
    printf 'artifact: %s\n' "$*" >&2
    exit 1
}

analysis() {
    "${COMPOSE[@]}" run --rm -T analysis "$@"
}

# Host prerequisites that no container can check. Every problem is listed
# before the command stops.
host_problems() {
    local problems=() arch version major minor
    if ! command -v docker >/dev/null 2>&1; then
        problems+=("Docker is not installed or not on PATH")
    elif ! docker info >/dev/null 2>&1; then
        problems+=("the Docker daemon does not answer; start Docker and retry")
    else
        # The Compose plugin from 2.3 on reads the project name from the file.
        if ! version=$(docker compose version --short 2>/dev/null); then
            problems+=("the Docker Compose plugin is missing; install Compose V2 or later")
        else
            IFS=. read -r major minor _ <<<"${version#v}"
            if (( major < 2 || (major == 2 && minor < 3) )); then
                problems+=("Docker Compose $version found; this release needs 2.3 or later")
            fi
        fi
        arch=$(docker info --format '{{.Architecture}}')
        if [[ "$arch" != x86_64 ]]; then
            printf 'note: Docker runs on %s; the release is tested on x86_64\n' "$arch" >&2
        fi
    fi
    if [[ ! -f "$RELEASE_MANIFEST" ]]; then
        problems+=("release manifest not found at $RELEASE_MANIFEST; place release-manifest.json next to the extracted teralizer/ directory or set TERALIZER_RELEASE_MANIFEST")
    fi
    if [[ ${#problems[@]} -gt 0 ]]; then
        printf 'preflight: %s\n' "${problems[@]}" >&2
        return 1
    fi
}

preflight() {
    local workflow="$1"
    step "Preflight for $workflow"
    host_problems || exit 1
    mkdir -p "$TERALIZER_OUTPUT" "$TERALIZER_STATE"
    # The component check runs in the analysis image, so the image is built first.
    "${COMPOSE[@]}" build -q analysis
    "${COMPOSE[@]}" run --rm -T --no-deps \
        -v "$(cd "$(dirname "$RELEASE_MANIFEST")" && pwd -P)/$(basename "$RELEASE_MANIFEST"):/release-manifest.json:ro" \
        analysis -m teralizer.release preflight "$workflow" \
        --workspace / --release-manifest /release-manifest.json
}

start_database() {
    step "Starting PostgreSQL"
    "${COMPOSE[@]}" up -d --wait postgres
}

# A corpus that is already restored and passes the report-role check is reused.
# Any other state is replaced from its component.
restore() {
    local corpus_id
    for corpus_id in "$@"; do
        step "Corpus $corpus_id"
        if analysis -m teralizer.corpora verify-corpus "$corpus_id" >/dev/null 2>&1; then
            printf 'reusing the restored and verified corpus %s\n' "$corpus_id"
        else
            "$ROOT/replication/scripts/import-databases.sh" --force "$corpus_id"
        fi
    done
}

# The output directory holds one run. A new run starts from an empty one, so
# no file of an earlier run can pass for a result of this one.
build_reports() {
    local report="$1"
    step "Building report $report into $TERALIZER_OUTPUT"
    find "$TERALIZER_OUTPUT" -mindepth 1 -delete
    analysis -m teralizer.eval "$report" --targets md,figures,latex,csv --output-root /output
}

verify() {
    step "Verifying the outputs, the paper's claims and the JARVIS inputs"
    # "$@" rather than an array: macOS's bash 3.2 rejects an empty array under set -u.
    analysis -m teralizer.release verify --analysis /output \
        --reference "$REFERENCE" --json /output/evidence.json "$@"
}

# The CUT-PVC capture runs the original Commons test cases of JARVIS Table 2 with the
# capture agent. Each run starts over and ends with a comparison against the published
# values, which the RQ0 report reads.
capture_cut_pvc() {
    local collection_root="$1"
    local work="$collection_root/data/cut-pvc-capture"
    local state_work="/state/collect/${collection_root##*/}/data/cut-pvc-capture"
    local published="$ROOT/analysis/data/jarvis-cut-values/cut_values.tsv"
    step "Capturing CUT-PVC values in $work"
    # The analysis service writes the aggregate as the invoking user, so the directory
    # is created here. Earlier raw captures are root-owned files of the pipeline container.
    mkdir -p "$work"
    "${COMPOSE[@]}" run --rm -T --no-deps teralizer rm -rf /app/data/cut-pvc-capture/raw
    "${COMPOSE[@]}" run --rm -T --no-deps analysis -m teralizer.cut_pvc plan |
        "${COMPOSE[@]}" run --rm -T --no-deps --name "${COMPOSE_PROJECT_NAME:-teralizer}-collect-cut-pvc" \
            teralizer scripts/lib/cut-pvc-capture.sh /dev/stdin \
            /app/data/jarvis-source-cache /app/data/cut-pvc-capture /app/data/cut-pvc-capture/raw
    "${COMPOSE[@]}" run --rm -T --no-deps analysis -m teralizer.cut_pvc aggregate \
        "$state_work/raw" --out "$state_work/cut_values.tsv"
    if cmp -s "$work/cut_values.tsv" "$published"; then
        printf 'CUT-PVC values match the published %s\n' "${published#"$ROOT"/}"
    else
        printf 'CUT-PVC values differ from the published %s. Compare %s\n' \
            "${published#"$ROOT"/}" "$work/cut_values.tsv"
    fi
}

copy_collection_tree() (
    local source="$1" target="$2" name parent temp
    [[ -d "$target" ]] && exit 0
    [[ -d "$source" ]] || fail "collection input is missing: $source"
    name="${target##*/}"
    parent="${target%/*}"
    mkdir -p "$parent"
    # An interrupted copy must not be mistaken for a project's working copy on resume.
    temp=$(mktemp -d "$parent/.copy.XXXXXX")
    trap 'rm -rf "$temp"' EXIT
    cp -pR "$source" "$temp/$name"
    mv "$temp/$name" "$target"
)

collect() {
    local scope="$1" corpus="$2" component workspace="$2" source project
    local sample="" jarvis_data="" runner="$ROOT/replication/scripts/run.sh"
    local scratch ledger logs stop_file="" rc=0
    local -a selected=()
    case "$corpus" in
        controlled)
            component=controlled
            scratch=scratch_replication_controlled
            # Controlled configs run for hours. Real-world keeps the runner's 1800 s default.
            export REPLICATION_PROJECT_TIMEOUT="${REPLICATION_PROJECT_TIMEOUT:-0}"
            if [[ "$scope" == reduced ]]; then
                selected=(commons-utils)
            fi
            ;;
        real-world)
            component="real-world-$scope"
            scratch=scratch_replication_real_world
            if [[ "$scope" == reduced ]]; then
                # A reduced working copy must never supply bytes to a full run.
                component=real-world-sample
                workspace=real-world-sample
                scratch=scratch_replication_real_world_sample
                sample="$ROOT/project-configs/replication/real-world-sample.txt"
            fi
            ;;
        jarvis-scenarios)
            # The scorecard collection also repeats the CUT-PVC capture, which clones the
            # pinned Commons Lang and Commons Math sources.
            component=jarvis-scoreboard
            jarvis_data=data/jarvis-scoreboard
            runner="$ROOT/scripts/run-jarvis-scoreboard.sh"
            scratch=scratch_jarvis_scoreboard
            ;;
        jarvis-benchmark)
            component=jarvis-census
            jarvis_data=data/jarvis-census
            runner="$ROOT/scripts/run-jarvis-census.sh"
            scratch=scratch_jarvis_census
            if [[ "$scope" == reduced ]]; then
                selected=(commons-cli-2017-02-01-census commons-csv-2017-02-01-census)
            fi
            ;;
        *)
            fail "unknown corpus '$corpus'. Choose controlled, real-world, jarvis-scenarios, or jarvis-benchmark"
            ;;
    esac

    preflight "collect-$component"
    # An image left by another release under the same Compose project would run old code.
    "${COMPOSE[@]}" build -q teralizer
    start_database

    local collection_root="$TERALIZER_STATE/collect/$workspace"
    local component_root="$ROOT/components/projects-$component"
    export TERALIZER_COMPOSE_FILE="$COMPOSE_FILE"
    export TERALIZER_COLLECT_PROJECTS="$collection_root/projects"
    export TERALIZER_COLLECT_DATA="$collection_root/data"
    export TERALIZER_PSQL_TRANSPORT=compose
    export JARVIS_DATA_ROOT="$collection_root"
    export REPLICATION_PROJECTS_ROOT="$collection_root"
    export REPLICATION_RUN_STATE_DIR="$collection_root/run-state"
    mkdir -p "$TERALIZER_COLLECT_PROJECTS" "$TERALIZER_COLLECT_DATA"

    step "Preparing working copies in $collection_root"
    local relative=projects
    if [[ -n "$jarvis_data" ]]; then
        relative="$jarvis_data/fixtures"
    fi
    if [[ -n "$sample" ]]; then
        while IFS=$' \t\r' read -r project || [[ -n "$project" ]]; do
            [[ -n "$project" ]] || continue
            # Let the runner report all missing sample directories or configs.
            if [[ -d "$component_root/$relative/$project" ]]; then
                copy_collection_tree "$component_root/$relative/$project" "$collection_root/$relative/$project"
            fi
        done < "$sample"
    elif [[ ${#selected[@]} -gt 0 ]]; then
        for project in "${selected[@]}"; do
            copy_collection_tree "$component_root/$relative/$project" "$collection_root/$relative/$project"
        done
    else
        for source in "$component_root/$relative/"*; do
            copy_collection_tree "$source" "$collection_root/$relative/${source##*/}"
        done
    fi

    if [[ -n "$jarvis_data" ]]; then
        export JARVIS_DATA_DIR="$jarvis_data"
        export JARVIS_SCRATCH_DB="$scratch"
        ledger="$collection_root/$jarvis_data/status.tsv"
        logs="$collection_root/$jarvis_data/run-logs"
        local -a args=(--reset-db)
        if [[ ${#selected[@]} -gt 0 ]]; then
            for project in "${selected[@]}"; do
                args+=("project-configs/jarvis-scoreboard/$project.conf")
            done
        fi
        "$runner" "${args[@]}" || rc=$?
        if [[ "$corpus" == jarvis-scenarios && $rc -eq 0 ]]; then
            capture_cut_pvc "$collection_root" || rc=$?
        fi
    else
        export REPLICATION_SCRATCH_DB="$scratch"
        export REPLICATION_DATA_DIR="data/replication-$corpus"
        ledger="$REPLICATION_RUN_STATE_DIR/status.tsv"
        stop_file="$REPLICATION_RUN_STATE_DIR/STOP"
        logs="terminal output"
        local -a args=(--corpus "$corpus" --docker --yes)
        if [[ "$corpus" == controlled ]]; then
            ledger="$REPLICATION_RUN_STATE_DIR"
            if [[ "$scope" == full ]]; then
                "$runner" "${args[@]}" --phase generation || rc=$?
            else
                args+=(--time dev --project commons-utils)
            fi
            if [[ $rc -eq 0 ]]; then
                "$runner" "${args[@]}" --phase generalization || rc=$?
            fi
        elif [[ -n "$sample" ]]; then
            "$runner" "${args[@]}" --sample "$sample" || rc=$?
        else
            "$runner" "${args[@]}" || rc=$?
        fi
    fi
    printf '\nWorking copies and pipeline data: %s\nRun ledger: %s\nLogs: %s\nScratch database: %s (Compose project %s)\n' \
        "$collection_root" "$ledger" "$logs" "$scratch" "${COMPOSE_PROJECT_NAME:-teralizer}"
    if [[ -n "$stop_file" ]]; then
        printf 'Pause at a config boundary: touch "%s"\n' "$stop_file"
        if [[ $rc -eq 75 ]]; then
            printf 'Collection paused. To resume, run ./artifact collect-%s %s again.\n' "$scope" "$corpus"
            return 0
        fi
    fi
    return "$rc"
}

clean_collection() (
    local collection_root="$TERALIZER_STATE/collect"
    [[ -d "$collection_root" && ! -L "$collection_root" ]] || exit 0
    # The pipeline may have written files as root. Remove them through the same image.
    export TERALIZER_COLLECT_PROJECTS="$collection_root"
    export TERALIZER_COLLECT_DATA="$collection_root"
    "${COMPOSE[@]}" run --rm -T --no-deps teralizer find /app/data -mindepth 1 -delete
)

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command" in
    preflight)
        [[ $# -le 1 ]] || fail "preflight takes at most one workflow"
        preflight "${1:-inspect}"
        ;;
    smoke)
        [[ $# -eq 0 ]] || fail "smoke takes no arguments"
        started=$SECONDS
        preflight smoke
        start_database
        restore "${JARVIS_CORPORA[@]}"
        build_reports rq0
        verify --report rq0
        printf '\nsmoke passed in %d min\n' $(( (SECONDS - started + 59) / 60 ))
        ;;
    reproduce-results)
        case "${1:-}" in
            "")
                preflight reproduce-all
                start_database
                restore "${ALL_CORPORA[@]}"
                build_reports all
                verify
                ;;
            rq0)
                preflight reproduce-rq0
                start_database
                restore "${JARVIS_CORPORA[@]}"
                build_reports rq0
                verify --report rq0
                ;;
            *)
                fail "reproduce-results takes no argument or rq0"
                ;;
        esac
        ;;
    collect-reduced|collect-full)
        [[ $# -eq 1 ]] || fail "$command requires one corpus"
        collect "${command#collect-}" "$1"
        ;;
    clean)
        [[ $# -eq 0 ]] || fail "clean takes no arguments"
        clean_collection
        step "Removing the services and volumes of ${COMPOSE_PROJECT_NAME:-teralizer}"
        "${COMPOSE[@]}" down --volumes --remove-orphans
        step "Removing $TERALIZER_OUTPUT and $TERALIZER_STATE"
        rm -rf "$TERALIZER_OUTPUT" "$TERALIZER_STATE"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
